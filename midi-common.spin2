pub note2freq(n): f
' Convert MIDI note number to frequency
'   n:          note number
'   Returns:    frequency in Hz (int)

    '440*(2^((69-69)/12))
    return round( 440.0 *. (__builtin_powf(2.0, ( (float(n) -. 69.0) /. 12.0) ) ) )


pub swap24(i): o
' Swap a 24-bit word's byte order
    o.byte[0], o.byte[1], o.byte[2] := i.byte[2], i.byte[1], i.byte[0]


pub swaplong(i): o
' Swap a long's byte order
    o.byte[0], o.byte[1], o.byte[2], o.byte[3] := i.byte[3], i.byte[2], i.byte[1], i.byte[0]


pub swapword(i): o
' Swap a word's byte order
    o.byte[0], o.byte[1] := i.byte[1], i.byte[0]


