{Spin2_v51}
con

    %interface blkio_i(
        pub rd_block(p_dest, len)
        pub rd_byte(): b
        pub rd_long(): l
        pub rd_word(): w
        pub wr_block(p_src, len)
        pub wr_byte(b)
        pub wr_long(l)
        pub wr_word(w)
        pub set_file(f)
        pub rd_ptr(): p
        pub wr_ptr(): p
        pub set_rd_ptr(p)
    )

con

    ' limits
    BUFFER_SZ       = 100
    MAX_MIDI_TRACKS = 32

    ' MIDI file metadata and structures
    TYPE_MTHD   = %"MThd"
    TYPE_MTRK   = %"MTrk"

    struct chunk_hdr_s(...
        long type, ...
        long length)

    struct event_s(...
        long delta, ...                         ' time since last event
        byte id, ...                            ' [7..4] id, [3..0] channel
        long length, ...
        byte param[2])

    struct meta_evt_s(...
        byte type, ...
        long length)    'xxx maybe long p_data too?

    struct channel_s(...
        word rpn, ...
        word data, ...
        word freq, ...
        long pitchbend_range)                   ' float: semitones + max(cents, 99)

    struct midifile_s(...
        long tempo, ...
        long smpte_fps, smpte_tpf, ...
        word format, ...
        word tracks, ...
        word divisions, ...
        channel_s channel[16])

    struct miditrack_s(...
        long start_pos, ...                     ' track start offset within file
        long length, ...                        ' track length
        long cursor, ...                        ' current pointer within track
        long tick, ...                          ' per-track absolute time
        event_s event, ...
        byte end_reached)                       ' end of track flag

    NOTE_OFF                = $80
    NOTE_ON                 = $90
    PROG_CHANGE             = $c0


    EVENT_META              = $ff
    META_TYPE_SEQ_NR        = $00
    META_TYPE_TEXT          = $01
    META_TYPE_COPYRIGHT     = $02
    META_TYPE_SEQ_TRK_NAME  = $03
    META_TYPE_INSTR_NAME    = $04
    META_TYPE_LYRIC         = $05
    META_TYPE_MARKER        = $06
    META_TYPE_CUEPOINT      = $07
    META_TYPE_MIDI_CH_PRE   = $20
    META_TYPE_END           = $2f
    META_TYPE_SET_TEMPO     = $51
    META_TYPE_SMPTE_OFFSET  = $54
    META_TYPE_TIME_SIG      = $58
    META_TYPE_KEY_SIG       = $59
    META_TYPE_SEQ_SPEC_META = $7f

' temporary, for debugging output
obj ser: "com.serial.terminal.ansi" | RX_PIN=34, TX_PIN=36, SER_BAUD=2_000_000

var

    ^blkio_i    iodev                           ' instance of the block I/O interface

    byte buffer[BUFFER_SZ]

    miditrack_s track[MAX_MIDI_TRACKS]
    midifile_s  this_file


pub set_iodev(^blkio_i p_obj)
' Set file I/O driver
'   p_obj:  pointer to OBJ containing the API defined in the blkio interface above
    [iodev] := [p_obj]
    ser.start()
    ser.clear()
    ser.strln(@"debug started")


pub bpm2tempo(b): t
' Convert beats per minute (BPM) to tempo (microseconds per quarter note)
    return 60_000_000/b


pub tempo2bpm(t): b
' Convert tempo (microseconds per quarter note) to beats per minute (BPM)
    return 60_000_000/t


pub ticks2usec(dt): s
' Convert MIDI ticks to microseconds
'   NOTE: This function depends on the tempo and divisions value
    return muldiv64(dt, this_file.tempo, this_file.divisions)


pub ticks2msec(dt): s
' Convert MIDI ticks to milliseconds
'   NOTE: This function depends on the tempo and divisions value
    return ticks2usec(dt) / 1000


pub header_valid(): s | chunk_hdr_s hdr
' Read the MIDI file header
'   Returns:
'       length field on success
'       zero on failure
    s := 0

    iodev.rd_block(@hdr, 8)
    if ( hdr.type == TYPE_MTHD )
        parse_mthd(@hdr)
        return hdr.length


pub parse_mthd(^chunk_hdr_s hdr)
' Parse Mthd header
'   hdr:    pointer to chunk header structure
    hdr.length := swaplong(hdr.length)
    this_file.format := iodev.rd_word()
    this_file.tracks := iodev.rd_word()
    parse_div( iodev.rd_word() )


pub parse_div(dw)
' Parse divisions
'   dw: division word
    if ( dw.[15] )                              ' SMPTE
        this_file.smpte_fps := dw.[8 addbits 6]
        this_file.smpte_tpf := dw.byte[0]
    else                                        ' ticks per quarter-note
        this_file.divisions := dw & $7fff


pub read_mtrk(^chunk_hdr_s hdr): l
' Read Mtrk chunk
'   hdr:    pointer to chunk header structure
    hdr.length := swaplong(hdr.length)
    return hdr.length


pub rd_event(^event_s event)
' Read event
'   event:  pointer to event_s structure
    event.delta := ticks2usec( rd_vlq() )
    event.id := iodev.rd_byte()
    ser.printf(@"rd_event(): delta=%d id=%x\n\r", event.delta, event.id)


var long _event_state
pub parse_event(^event_s event): t
' Parse MIDI event
'   event:  pointer to event structure
'    event.delta := ticks2usec( rd_vlq() )
'    event.id := iodev.rd_byte()
'    ser.printf(@"parse_event(): delta=%d id=%x\n\r", event.delta, event.id)
    ' is it a status byte?
    if ( (event.id >= $80) and (event.id <= $ff) )
        ser.printf(@"\033[1;34mswitched event state to %0x\033[m\n\r", event.id)
        case event.id & $f0
            EVT_NOTE_OFF:
                parse_note_off(event.id & $0f)
            EVT_NOTE_ON:
                parse_note_on(event.id & $0f)
            EVT_CTRL_CHANGE:
                parse_ctrl_change(event.id & $0f)
            EVT_PROG_CHANGE:
                parse_prog_change(event.id & $0f)
            EVT_PITCHBEND_CHANGE:
                parse_pitchbend_change(event.id & $0f)
            other:
                ser.printf(@"unknown event %x\n\r", event.id)
        _event_state := event.id & $f0
    else
        case _event_state
            EVT_CTRL_CHANGE:
            EVT_NOTE_ON:
                parse_note_on(event.id & $0f)
            EVT_NOTE_OFF:
                parse_note_off(event.id & $0f)

    return event.id


pub parse_ctrl_change(ch) | ctl, val
' Parse controller change event
'   ch: channel
    ser.str(@"parse_ctrl_change() ")
    ctl := iodev.rd_byte()                            ' change controller to...
    val := iodev.rd_byte()                            '   value
    ser.printf(@"ctl=%x  val=%x\n\r", ctl, val)


pub parse_meta_event(^meta_evt_s meta_evt): t | p
' Parse a meta event
'   t:  meta event type
    meta_evt.type := iodev.rd_byte()
    meta_evt.length := rd_vlq()
    bytefill(@buffer, 0, 100)
    ser.printf(@"parse_meta_event(): type=%x len=%d\n\r", meta_evt.type, meta_evt.length)
    case meta_evt.type
        META_TYPE_SEQ_NR:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_TEXT:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_COPYRIGHT:
            iodev.rd_block(@buffer, meta_evt.length)
            ser.printf(@" META_TYPE_COPYRIGHT: '%s'\n\r", @buffer)
        META_TYPE_SEQ_TRK_NAME:
            iodev.rd_block(@buffer, meta_evt.length)
            ser.printf(@" META_TYPE_SEQ_TRK_NAME: '%s'\n\r", @buffer)
        META_TYPE_INSTR_NAME:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_LYRIC:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_MARKER:
            read_marker(@buffer, meta_evt.length)
        META_TYPE_CUEPOINT:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_MIDI_CH_PRE:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_END:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_SET_TEMPO:
            'if ( meta_evt.length <> 3 ) ' xxx this was showing a warning over serial/debug
            parse_tempo()
        META_TYPE_SMPTE_OFFSET:
            iodev.rd_block(@buffer, meta_evt.length)
        META_TYPE_TIME_SIG:
            parse_time_sig()
        META_TYPE_KEY_SIG:
            parse_key_sig()
        META_TYPE_SEQ_SPEC_META:
            iodev.rd_block(@buffer, meta_evt.length)

    return meta_evt.type


pub read_marker(p_dest, len)

    iodev.rd_block(p_dest, len <# BUFFER_SZ)
    ser.printf(@"read_marker: '%s'\n\r", p_dest)

    if ( len > BUFFER_SZ )
        repeat len-BUFFER_SZ
            iodev.rd_byte()


pub parse_key_sig() | ksig, scl

    ksig := iodev.rd_byte() ' -7..7
    scl := iodev.rd_byte()  '0: major, 1: minor
    ser.printf(@"parse_key_sig(): key: %d  scale: %d\n\r", ksig, scl)


pub parse_note_off(ch) | k, v
' Parse note off event
'   ch: channel
    ser.printf(@"parse_note_off(%d) ", ch)
    k := iodev.rd_byte()                              ' note #
    v := iodev.rd_byte()                              ' value
    ser.printf(@" k=%d v=%d\n\r", k, v)


pub parse_note_on(ch) | k, v
' Parse note on event
'   ch: channel
    ser.printf(@"parse_note_on(%d) ", ch)
    k := iodev.rd_byte()
    v := iodev.rd_byte()
    ser.printf(@" k=%d v=%d\n\r", k, v)


pub parse_pitchbend_change(ch) | p
' Parse pitchbend change event
'   ch: channel
    p := iodev.rd_byte()                              ' new pitchbend value
    p |= (iodev.rd_byte() << 7)


pub parse_prog_change(ch) | prg
' Parse program change event
'   ch: channel
    prg := iodev.rd_byte()


pub parse_tempo() | t
' Parse tempo event
    t := 0
    iodev.rd_block(@t, 3)
    t := swap24(t)
    this_file.tempo := t
    ser.printf(@"parse_tempo(): t=%d\n\r", t)

pub parse_time_sig() | nn, dd, cc, bb
' Parse time-signature event
    nn := iodev.rd_byte()
    dd := iodev.rd_byte()
    cc := iodev.rd_byte()
    bb := iodev.rd_byte()
    ser.printf(@"parse_time_sig(): nn=%x dd=%x cc=%x bb=%x\n\r", nn, dd, cc, bb)

pub write_controller_change(ch, c, v, dt=0)
'   ch:     channel
'   c:      controller ID
'   v:      new value
'   dt:     delta-time (optional; default is 0)
    wr_vlq(dt)
    iodev.wr_byte(EVT_CTRL_CHANGE | ch)
    iodev.wr_byte(c)
    iodev.wr_byte(v)


pub write_copyright(p_src, len, dt=0)
' Write a copyright meta event
'   p_src:  pointer to copyright text string
'   len:    length of string
'   dt:     delta-time (optional; default is 0)
    write_meta_event(dt)
    iodev.wr_byte(META_TYPE_COPYRIGHT)
    wr_vlq(len)
    iodev.wr_block(p_src, len)


pub write_header(len, fmt, trks, divs)
' Write MIDI file header
'   len:    length of header data
'   fmt:    format
'   trks:   number of tracks
'   divs:   number of divisions
    iodev.wr_long(TYPE_MTHD)
    iodev.wr_long(swaplong(len))
    iodev.wr_word(fmt)
    iodev.wr_word(trks)
    iodev.wr_word(divs)


pub write_meta_event(dt)
' Write meta event
'   dt: delta time
    wr_vlq(dt)
    iodev.wr_byte(EVENT_META)


pub write_mtrk(len)
' Write Mtrk chunk header
'   len:    MTrk chunk length
    iodev.wr_long(TYPE_MTRK)
    iodev.wr_long(swaplong(len))


pub write_note_off(ch, k, v, dt=0)
' Write note off event
'   ch:     MIDI channel ID (0..15)
'   k:      key
'   v:      velocity
'   dt:     delta-time (optional; default is 0)
    wr_vlq(dt)
    iodev.wr_byte(NOTE_OFF | ch)
    iodev.wr_byte(k)
    iodev.wr_byte(v)


pub write_note_on(ch, k, v, dt=0)
' Write note on event
'   ch:     MIDI channel ID (0..15)
'   k:      key
'   v:      velocity
'   dt:     delta-time (optional; default is 0)
    wr_vlq(dt)
    iodev.wr_byte(NOTE_ON | ch)
    iodev.wr_byte(k)
    iodev.wr_byte(v)


pub write_pitchbend_change(ch, p, dt=0)
' Write pitchbend change event
'   ch:     MIDI channel ID (0..15)
'   p:      new pitch
'   dt:     delta-time (optional; default is 0)
    wr_vlq(dt)
    iodev.wr_byte(EVT_PITCHBEND_CHANGE | ch)
    iodev.wr_byte(p & $7f)
    iodev.wr_byte( (p >> 7) & $7f)


pub write_prog_change(ch, prg, dt=0)
' Write program change event
'   ch:     MIDI channel ID (0..15)
'   prg:    new program
'   dt:     delta-time (optional; default is 0)
    wr_vlq(dt)
    iodev.wr_byte(PROG_CHANGE | ch)
    iodev.wr_byte(prg)


pub write_set_tempo(t, dt=0)
' Write set tempo event
'   t:      new tempo
'   dt:     delta-time (optional; default is 0)
    write_meta_event(dt)
    iodev.wr_byte(META_TYPE_SET_TEMPO)


pub write_track_end(dt=0)
' Write track end meta event
'   dt:     delta time (optional; default is 0)
    write_meta_event(dt)
    iodev.wr_byte(META_TYPE_END)


pub write_track_name(p_src, len, dt=0)
' Write track name event
'   p_src:  pointer to track name string
'   len:    length of string
'   dt:     delta-time (optional; default is 0)
    write_meta_event(dt)
    iodev.wr_byte(META_TYPE_SEQ_TRK_NAME)
    wr_vlq(len)
    iodev.wr_block(p_src, len)


pub rd_vlq(): v | c
' Read and decode a variable-length quantity from the file
'   Returns:    decoded/decimal value
    v := iodev.rd_byte()
'    ser.printf(@"vlq %x ", v)
    if ( v & $80 )
        v &= $7f
        repeat
            v := (v << 7) | ( (c := iodev.rd_byte() ) & $7f)
'            ser.printf(@"%x ", c)
        while (c & $80)
'    ser.printf(@"vlq in dec=%d\n\r", v)
    return v & $0fff_ffff


pri wr_vlq(val) | buffer
' Write a value encoded as a variable-length quantity to the file
'   val:    decimal value
    buffer := val & $7f
    repeat while ((val >>= 7) > 0)
        buffer <<= 8
        buffer |= $80
        buffer += (val & $7f)

    repeat
        iodev.wr_byte(buffer)
        if ( buffer & $80 )
            buffer >>= 8
        else
            quit


#include "midi-common.spin2"                    ' use code common to MIDI file and device I/O


dat
