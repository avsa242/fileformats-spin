{
---------------------------------------------------------------------------------------------------
    Filename:       BMPView-terminal.spin2
    Description:    Terminal-based BMP viewer
    Author:         Jesse Burt
    Started:        Aug 1, 2025
    Updated:        Aug 2, 2025
    Copyright (c) 2025 - See end of file for terms of use.
---------------------------------------------------------------------------------------------------

    NOTE: This requires a 24bpp-capable terminal or terminal emulator
    Tested using
        * KDE Konsole
        * PuTTY and pterm
    Windows Powershell is reported to support this but is untested
}

con

    _clkfreq            = 180_000_000
    _xtlfreq            = 20_000_000


' -- User-modifiable constants
    SD_CLK              = 61                    ' SD card pins
    SD_CS               = 60
    SD_DI               = 59
    SD_DO               = 58

    TERM_WIDTH          = 160                   ' your terminal emulator's dimensions
    TERM_HEIGHT         = 120

    BMP_WIDTH_MAX       = 160                   ' linebuffer sizing
' --


dat

    bmp_file    byte "/sd/IMAGE.BMP", 0         ' filename of image to load from SD


obj

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    bmp:    "file.image.bmp"                    ' BMP image metadata support
    libc:   "libc"                              ' vfs/SD support


var

    byte _linebuff[BMP_WIDTH_MAX*4]             ' accommodate one image line (32bpp)


pub main() | m, f, rgb24, x, y, i, fp, lc

    ser.start()
    ser.clear()

    m := _mount(@"/sd", libc._vfs_open_sdcardx(SD_CLK, SD_CS, SD_DI, SD_DO) )
    if ( m )
        ser.printf(@"error mounting SD card: %d\n\r", m)
        repeat

    f := libc.fopen(@bmp_file, @"rb")
    ifnot ( f )
        ser.strln(@"error opening BMP file")
        repeat

    ' read the BMP header
    libc.fread(@bmp.header.bmp, bmp.BMP_HEADER_SZ, 1, f)
    libc.fread(@bmp.header.dib, bmp.BITMAPV5HEADER_SZ, 1, f)

    repeat
        fp := bmp.imagedata_start()             ' point to the start of the image data
        ser.clear()
        repeat TERM_HEIGHT with y
            ' read a line of data from the image
            longfill(@_linebuff, 0, BMP_WIDTH_MAX)
            libc.fseek(f, fp, libc.SEEK_SET)    ' seek to the start of the image data
            libc.fread(@_linebuff, bmp.bytes_per_line(), 1, f)
            i := 0
            ser.pos_x(0)                        ' move to the leftmost terminal column
            repeat TERM_WIDTH with x
                rgb24 := (_linebuff[i] | (_linebuff[i+1] << 8) | (_linebuff[i+2] << 16) ) << 8
                if ( rgb24 <> lc )              ' if this pixel's color is different than the previous,
                    ser.bgcolor_24bpp(rgb24)    ' draw it in the background color,
                ser.putchar(" ")                '   using a space as the 'pixel' character
                i += 4                          ' go to the next pixel's data
                lc := rgb24                     ' remember this as the 'last' color we drew

            ser.newline()

            ' go to the next row of the image (could be backwards or forwards in the image data,
            '   depending on the BMP)
            ' if the BMP is taller than your terminal, it will 'scroll' as it draws past the bottom
            fp := fp + ( bmp.bytes_per_line() * bmp.row_order() )

        ser.getchar()                           ' press a key to display again


DAT
